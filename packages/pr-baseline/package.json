{
	"name": "@mawesome/pr-baseline",
	"version": "0.2.0",
	"description": "Keep open pull requests current with a movable baseline on the base branch, reported through commit statuses",
	"keywords": [
		"baseline",
		"ci",
		"commit-status",
		"github",
		"github-actions",
		"pull-request"
	],
	"homepage": "https://github.com/mawesomedev/mawesome/tree/main/packages/pr-baseline#readme",
	"bugs": "https://github.com/mawesomedev/mawesome/issues",
	"license": "MIT",
	"author": "Manzoor Ahmad Wani",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mawesomedev/mawesome.git",
		"directory": "packages/pr-baseline"
	},
	"bin": {
		"pr-baseline": "./dist/cli.js"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"typecheck": "tsgo",
		"test": "vitest run",
		"check:exports": "attw --pack . && publint --strict"
	},
	"dependencies": {
		"@octokit/core": "^7.0.8",
		"@octokit/plugin-retry": "^8.1.1",
		"ignore": "^7.0.9"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"@mawesome/testing": "workspace:*",
		"@mawesome/tsconfig": "workspace:*",
		"@types/node": "^26.5.1",
		"@typescript/native-preview": "7.0.0-dev.20260527.2",
		"publint": "^0.3.24",
		"tsdown": "^0.23.0",
		"vitest": "^5.0.0"
	},
	"engines": {
		"node": ">=24.12.0"
	}
}

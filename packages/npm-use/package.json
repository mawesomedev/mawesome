{
	"name": "@mawesome/npm-use",
	"version": "0.0.0",
	"description": "Run the npm version a project declares in devEngines, whatever Node is active",
	"keywords": [
		"devengines",
		"fnm",
		"npm",
		"nvm",
		"package-manager",
		"version-manager"
	],
	"homepage": "https://github.com/mawesomedev/mawesome/tree/main/packages/npm-use#readme",
	"bugs": "https://github.com/mawesomedev/mawesome/issues",
	"license": "MIT",
	"author": "Manzoor Ahmad Wani",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mawesomedev/mawesome.git",
		"directory": "packages/npm-use"
	},
	"bin": {
		"npm-use": "./dist/cli.js"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"typecheck": "tsgo",
		"test": "vitest run",
		"check:exports": "attw --pack . && publint --strict"
	},
	"dependencies": {
		"@npmcli/config": "^10.14.0",
		"semver": "^7.8.5",
		"sigstore": "^4.1.1",
		"tar": "^7.5.22",
		"undici": "^7.30.0"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"@mawesome/testing": "workspace:*",
		"@mawesome/tsconfig": "workspace:*",
		"@types/node": "^26.4.1",
		"@types/semver": "^7.8.0",
		"@typescript/native-preview": "7.0.0-dev.20260527.2",
		"publint": "^0.3.24",
		"tsdown": "^0.23.0",
		"vitest": "^5.0.0"
	},
	"engines": {
		"node": ">=22.9.0"
	}
}
